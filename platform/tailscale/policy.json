{
	"tagOwners": {
		"tag:untrusted": ["autogroup:admin"],
		"tag:server":    ["autogroup:admin"]
	},
	"grants": [
		{"src": ["autogroup:member"], "dst": ["*"], "ip": ["*"]}
	],
	"ssh": [
		{
			"action": "accept",
			"src":    ["autogroup:admin"],
			"dst":    ["tag:server"],
			"users":  ["autogroup:nonroot", "root"]
		},
		{
			"action": "accept",
			"src":    ["autogroup:admin"],
			"dst":    ["tag:untrusted"],
			"users":  ["autogroup:nonroot", "root"]
		},
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"]
		}
	]
}
