# cp envs/prod.tfvars.example envs/prod.tfvars (gitignored) and fill.
subscription_id       = "00000000-0000-0000-0000-000000000000"
resource_group_name   = "treaulab-prod-rg"
location              = "westeurope"
create_resource_group = false

vm_name        = "treaulab-prod-vps"
vm_size        = "Standard_B2s"
admin_username = "azureuser"
admin_ssh_key  = "ssh-ed25519 AAAA... you@machine"

# Your home/office IP, not "*" (203.0.113.10 is TEST-NET-3 documentation space).
allowed_ssh_cidr = "203.0.113.10/32"
