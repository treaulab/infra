# cp envs/prod.tfvars.example envs/prod.tfvars (gitignored) and fill.
# Provider credentials are NEVER kept here; they are loaded from the gitignored
# .envrc by direnv (see .envrc.example):
#   export PROXMOX_VE_ENDPOINT="https://192.168.1.100:8006/"
#   export PROXMOX_VE_API_TOKEN="terraform@pve!token=00000000-0000-0000-0000-000000000000"
#   export PROXMOX_VE_INSECURE="true"

proxmox_node_name = "pve"
datastore_iso     = "local"
datastore_vm      = "local-lvm"

# Ubuntu 26.04 LTS ('Resolute Raccoon') minimal cloud image (default)
cloud_image_url       = "https://cloud-images.ubuntu.com/minimal/releases/resolute/release/ubuntu-26.04-minimal-cloudimg-amd64.img"
cloud_image_file_name = "ubuntu-26.04-minimal-cloudimg-amd64.qcow2"
cloud_image_checksum  = "6c083e6bea1573aab619c1dfa8d17bb7e3a8618fbd6cb57fa39d517b20062aa4"

vm_network_bridge = "vmbr0"
vm_ipv4_gateway   = "192.168.1.1"
vm_dns_servers    = ["1.1.1.1", "1.0.0.1"]

admin_username = "treau"
admin_ssh_key  = "ssh-ed25519 AAAA... you@machine"

# Declarative VM Fleet Map
vms = {
  mercury = {
    vm_id        = 500
    ipv4_address = "192.168.10.50/24"
    tags         = ["internal", "docker", "tofu", "ubuntu-26.04"]
    description  = "Managed by OpenTofu (platform/proxmox) - Internal Docker Host"
  }
  venus = {
    vm_id         = 501
    ipv4_address  = "192.168.10.51/24"
    startup_order = 2
    tags          = ["internal", "k3s", "tofu", "ubuntu-26.04"]
    description   = "Managed by OpenTofu (platform/proxmox) - Dedicated K3s Host"
  }
}
