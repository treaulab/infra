# cp envs/prod.tfvars.example envs/prod.tfvars (gitignored) and fill.
# Provider credentials can also be supplied via environment variables:
#   export PROXMOX_VE_ENDPOINT="https://192.168.1.100:8006/"
#   export PROXMOX_VE_API_TOKEN="terraform@pve!token=00000000-0000-0000-0000-000000000000"

proxmox_endpoint  = "https://192.168.1.100:8006/"
proxmox_api_token = "terraform@pve!token=00000000-0000-0000-0000-000000000000"
proxmox_insecure  = true
proxmox_node_name = "pve"

datastore_iso = "local"
datastore_vm  = "local-lvm"

# Ubuntu 26.04 LTS ('Resolute Raccoon') minimal cloud image (default)
cloud_image_url      = "https://cloud-images.ubuntu.com/minimal/releases/resolute/release/ubuntu-26.04-minimal-cloudimg-amd64.img"
cloud_image_file_name = "ubuntu-26.04-minimal-cloudimg-amd64.img"
cloud_image_checksum = "6c083e6bea1573aab619c1dfa8d17bb7e3a8618fbd6cb57fa39d517b20062aa4"

# Fallback to Ubuntu 24.04 LTS ('Noble Numbat') if desired:
# cloud_image_url       = "https://cloud-images.ubuntu.com/minimal/releases/noble/release/ubuntu-24.04-minimal-cloudimg-amd64.img"
# cloud_image_file_name = "ubuntu-24.04-minimal-cloudimg-amd64.img"

vm_name           = "treaulab-homelab-docker"
vm_cores          = 2
vm_memory_mb      = 4096
vm_memory_min_mb  = 2048 # Dynamic ballooning threshold
vm_disk_size_gb   = 32

vm_network_bridge = "vmbr0"
vm_ipv4_address   = "dhcp"
# For static IP instead of dhcp:
# vm_ipv4_address = "192.168.1.50/24"
# vm_ipv4_gateway = "192.168.1.1"
# vm_dns_servers  = ["1.1.1.1", "1.0.0.1"]

admin_username = "treau"
admin_ssh_key  = "ssh-ed25519 AAAA... you@machine"
