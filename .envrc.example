# Local provider credentials for OpenTofu plans.
# Copy to .envrc, fill in the values, and run: direnv allow .
# .envrc is gitignored and must stay mode 0600.
#
# This is the temporary plaintext-local convenience path. Later, replace the
# secret exports with `secret-tool` (GNOME Keyring) or `op read` (1Password).

# Tailscale OAuth client (preferred).
export TAILSCALE_OAUTH_CLIENT_ID="k..."
export TAILSCALE_TAILNET="you@example.com"
export TAILSCALE_OAUTH_CLIENT_SECRET="tskey-client-..."

# Fallback instead of the OAuth pair; use one path, not both:
# export TAILSCALE_API_KEY="tskey-api-..."

# Cloudflare API token: Zone -> DNS:Edit + Zone -> Zone:Read for treau.me.
export CLOUDFLARE_API_TOKEN="..."

# Proxmox VE API provider (homelab compute).
export PROXMOX_VE_ENDPOINT="https://192.168.1.100:8006/"
export PROXMOX_VE_API_TOKEN="terraform@pve!token=00000000-0000-0000-0000-000000000000"
export PROXMOX_VE_INSECURE="true"

# GitHub: do not store a static token here. Use the admin account dynamically:
#   GITHUB_TOKEN="$(gh auth token --user slancj)" just plan tailscale
