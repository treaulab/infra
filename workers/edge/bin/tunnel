#!/usr/bin/env node
// treaulab tunnel CLI: cloudflared-style ergonomics for the edge tunnels.
// Zero dependencies, Node 22+. Local state (names, rooms, upstreams) lives in
// ~/.config/treaulab/tunnels.json; host defaults to https://go.treau.me
// (override with TUNNEL_HOST env or `tunnel config set host`).
// Long-URL-only: the room/box ID in the URL is the secret (no tokens).
//
//   tunnel --url <UPSTREAM>  instant share, zero setup (trycloudflare-style)
//   tunnel quickstart        first-run checks + next steps (host optional)
//   tunnel login [--host H]  verify wrangler auth + override default host
//   tunnel create <name> [--http --upstream URL | --tcp --to HOST:PORT] [--room ID]
//   tunnel list | url <name> | run <name> | ssh <name> | ssh-config <name>
//   tunnel logs | delete <name> | config [get|set] | doctor

import { spawn, spawnSync } from "node:child_process";
import crypto from "node:crypto";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import readline from "node:readline";

const HERE = path.dirname(new URL(import.meta.url).pathname);
const EDGE_DIR = path.resolve(HERE, "..");
const AGENTS = {
	http: path.join(EDGE_DIR, "agent", "agent.js"),
	tcp: path.join(EDGE_DIR, "agent", "tcp-agent.js"),
};
const PROXY = path.join(HERE, "ws-ssh-proxy.js");

const CONF_DIR = path.join(process.env.XDG_CONFIG_HOME ?? path.join(os.homedir(), ".config"), "treaulab");
const STATE_FILE = path.join(CONF_DIR, "tunnels.json");
const CONFIG_FILE = path.join(CONF_DIR, "config.json");

const NAME_RE = /^[A-Za-z0-9_-]{1,64}$/;
// Default edge host (go.treau.me). Precedence everywhere: TUNNEL_HOST env >
// config.json host > this default. Override per-box, never edit here.
const DEFAULT_HOST = "https://go.treau.me";
// Long URL IDs: 20-64 chars, must match edge worker ID_RE in src/worker.js.
const ID_RE = /^[A-Za-z0-9_-]{20,64}$/;
function newRoomId() {
	return crypto.randomBytes(24).toString("hex").slice(0, 32);
}

const fail = (msg, code = 1) => {
	console.error(`tunnel: ${msg}`);
	process.exit(code);
};
const info = (...a) => console.log(...a);

function readJson(file, fallback) {
	try {
		return JSON.parse(fs.readFileSync(file, "utf8"));
	} catch {
		return fallback;
	}
}
function writeJson(file, obj, mode) {
	fs.mkdirSync(path.dirname(file), { recursive: true });
	fs.writeFileSync(file, JSON.stringify(obj, null, 2) + "\n", { mode });
}

const loadState = () => readJson(STATE_FILE, { tunnels: {} });
const saveState = (s) => writeJson(STATE_FILE, s);
const loadConfig = () => readJson(CONFIG_FILE, {});
const saveConfig = (c) => writeJson(CONFIG_FILE, c);

function edgeHost() {
	// Default host: override with TUNNEL_HOST env or `tunnel config set host`.
	const h = (process.env.TUNNEL_HOST || loadConfig().host || DEFAULT_HOST).replace(/\/$/, "");
	if (!/^https?:\/\//.test(h)) fail(`bad host ${JSON.stringify(h)} — want https://...`);
	return h;
}
const wsBase = () => edgeHost().replace(/^http/, "ws");

function getTunnel(name) {
	const t = loadState().tunnels[name];
	if (!t) fail(`unknown tunnel ${JSON.stringify(name)} — see: tunnel list`);
	return t;
}

function prompt(question) {
	return new Promise((resolve) => {
		const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
		rl.question(question, (ans) => {
			rl.close();
			resolve(ans.trim());
		});
	});
}

// Hidden input (no echo). Falls back to visible if stdin isn't a TTY.
function promptHidden(question) {
	if (!process.stdin.isTTY) return prompt(question);
	return new Promise((resolve) => {
		process.stdout.write(question);
		const stdin = process.stdin;
		stdin.setRawMode(true);
		stdin.resume();
		let buf = "";
		const done = () => {
			stdin.setRawMode(false);
			stdin.pause();
			stdin.removeListener("data", onData);
			process.stdout.write("\n");
			resolve(buf.trim());
		};
		function onData(c) {
			const s = c.toString("utf8");
			if (s === "\n" || s === "\r" || s === "\u0004") return done();
			if (s === "\u0003") {
				process.stdout.write("\n");
				process.exit(130);
			}
			if (s === "\u007f") {
				buf = buf.slice(0, -1);
				return;
			}
			buf += s;
		}
		stdin.on("data", onData);
	});
}

function checkNode() {
	const [maj] = process.versions.node.split(".").map(Number);
	if (maj < 22) fail(`node >= 22 required, have ${process.versions.node}`);
}
function haveBin(bin) {
	return spawnSync(process.platform === "win32" ? "where" : "which", [bin]).status === 0;
}

// ---- commands ------------------------------------------------------------

function cmdHelp(cmd) {
	const per = {
		login: "usage: tunnel login [--host H]\n  like `cloudflared tunnel login`: override the default edge host (go.treau.me).",
		create: "usage: tunnel create <name> [--http --upstream URL | --tcp --to HOST:PORT] [--room ID]\n  like `cloudflared tunnel create`: remember a named tunnel + its ingress.\n  Room ID defaults to a fresh 32-char secret (the long URL). Pass --room to reuse one.\n  aliases: tunnel add-site <name> <port> | tunnel add-ssh <name> [HOST:PORT]",
		list: "usage: tunnel list\n  like `cloudflared tunnel list`: show named tunnels.",
		info: "usage: tunnel info <name>\n  like `cloudflared tunnel info`: details + live agent check.",
		route: "usage: tunnel route <name>\n  like `cloudflared tunnel route dns`: print the public URL for a tunnel.\n  (alias: tunnel url <name>)",
		run: "usage: tunnel run <name>\n  like `cloudflared tunnel run`: run the origin connector in the foreground.",
		delete: "usage: tunnel delete <name> [-f]\n  like `cloudflared tunnel delete`: forget a tunnel (rooms vanish when unused).",
		cleanup: "usage: tunnel cleanup <name>\n  like `cloudflared tunnel cleanup`: clear stale state (rooms are ephemeral;\n  reports agent liveness, drops nothing that matters).",
		access: "usage: tunnel access ssh <name> [--print] [ssh-args...]\n       tunnel access ssh-config <name> [--install]\n  like `cloudflared access ssh`: connect through the pipe.",
		logs: "usage: tunnel logs\n  tail live edge logs (wrangler tail).",
		config: "usage: tunnel config [get [host] | set host <URL>]",
		doctor: "usage: tunnel doctor\n  self-check: node, ssh, host (+ tunnel status).",
		quickstart: "usage: tunnel quickstart [--host H]\n  first-run: checks + next steps (host defaults to go.treau.me).",
	};
	if (cmd && per[cmd]) return info(per[cmd]);
	info(`usage: tunnel [--url <UPSTREAM>] [command] [args]   (mirrors cloudflared tunnel)

  quick (no setup, like trycloudflare — host defaults to go.treau.me):
    tunnel --url http://127.0.0.1:8080 [--name tmp] [--output json]
                                ephemeral share: prints public URL, runs agent

  manage tunnels (like cloudflared tunnel login/create/list/info/delete):
    login [--host H]            override the default edge host
    create <name> [--http --upstream URL | --tcp --to HOST:PORT]
                                remember a tunnel (room ID auto-generated, long URL)
    list                        show named tunnels
    info <name>                 details + live agent check
    delete <name> [-f]          forget a tunnel
    cleanup <name>              clear stale state (ephemeral rooms)

  route + run (like cloudflared tunnel route dns / run):
    route <name>                print the public URL (alias: url)
    run <name>                  run the origin connector (foreground)

  access (like cloudflared access ssh):
    access ssh <name>           ssh through the pipe (alias: ssh)
    access ssh-config <name>    print/install ~/.ssh/config block

  maintain:
    quickstart [--host H]       first-run wizard (host optional, defaults work)
    logs | config | doctor      tail logs, inspect host, self-check

  cloudflared muscle memory also works: tunnel tunnel <subcommand>
  per-command help: tunnel <command> --help

state: ${STATE_FILE}`);
}

function cmdLogin(argv) {
	checkNode();
	const get = (f) => {
		const i = argv.indexOf(f);
		return i >= 0 && argv[i + 1] ? argv[i + 1] : null;
	};
	const cfg = loadConfig();
	const host = get("--host") || process.env.TUNNEL_HOST || cfg.host || DEFAULT_HOST;

	info(`node ${process.versions.node} OK`);
	info(haveBin("wrangler") || haveBin("npx") ? "wrangler available" : "note: wrangler not found (only needed for `tunnel logs` / deploys)");
	const who = spawnSync("npx", ["wrangler", "whoami"], { cwd: EDGE_DIR, encoding: "utf8" });
	if (who.status === 0) {
		const line = (who.stdout + who.stderr).split("\n").find((l) => /logged in|email/i.test(l));
		info(line?.trim() ? `cloudflare auth: ${line.trim()}` : "cloudflare auth OK");
	} else {
		info("note: `npx wrangler login` not completed (needed for deploys + `tunnel logs`, not for using tunnels)");
	}

	return (async () => {
		let h = host;
		// Interactive: offer to override the default. Non-interactive with no
		// --host just keeps the default (no setup required anymore).
		if (process.stdin.isTTY && !get("--host")) {
			const ans = await prompt(`edge host [${DEFAULT_HOST}]: `);
			if (ans) h = ans;
		}
		saveConfig({ ...cfg, host: h.replace(/\/$/, "") });
		info(`host: ${h}`);
		info("done. next: tunnel create <name> --http|--tcp ... (room ID is the long URL secret)");
	})();
}

function cmdCreate(argv) {
	const [name, ...rest] = argv;
	if (!name || !NAME_RE.test(name)) fail("usage: tunnel create <name> [--http --upstream URL | --tcp --to HOST:PORT] [--room ID]");
	const get = (f) => {
		const i = rest.indexOf(f);
		return i >= 0 && rest[i + 1] ? rest[i + 1] : null;
	};
	const wantHttp = rest.includes("--http");
	const wantTcp = rest.includes("--tcp");
	const upstream = get("--upstream");
	const to = get("--to");
	const room = get("--room") || newRoomId();
	if (!ID_RE.test(room)) fail(`bad room ID ${JSON.stringify(room)} — want 20-64 chars [A-Za-z0-9_-] (default is auto-generated; rotate by re-creating)`);
	let kind = wantTcp ? "tcp" : wantHttp ? "http" : upstream ? "http" : to ? "tcp" : null;
	if (!kind) fail("say which kind: --http --upstream <URL>  or  --tcp --to <HOST:PORT>");
	if (kind === "http" && !upstream) fail("--http needs --upstream <URL> (e.g. http://127.0.0.1:8080)");
	if (kind === "tcp" && !to) fail("--tcp needs --to <HOST:PORT> (e.g. 127.0.0.1:22)");
	const state = loadState();
	if (state.tunnels[name] && !rest.includes("--force")) {
		fail(`${JSON.stringify(name)} already exists — pick another name or re-run with --force`);
	}
	state.tunnels[name] = {
		kind,
		room,
		...(kind === "http" ? { upstream } : { to }),
		createdAt: new Date().toISOString(),
	};
	saveState(state);
	info(`remembered ${kind} tunnel ${JSON.stringify(name)} (long URL ID ${room})`);
	info(kind === "http" ? `route:  tunnel route ${name}   (public URL)` : `connect:  tunnel access ssh ${name}`);
}

function cmdList() {
	const tunnels = loadState().tunnels;
	const names = Object.keys(tunnels);
	if (!names.length) return info("no tunnels yet — see: tunnel create <name> --http|--tcp ...");
	const rows = [["NAME", "KIND", "ROOM", "TARGET"]];
	for (const n of names.sort()) {
		const t = tunnels[n];
		rows.push([n, t.kind, t.room, t.kind === "http" ? t.upstream : t.to]);
	}
	const widths = rows[0].map((_, i) => Math.max(...rows.map((r) => r[i].length)));
	for (const r of rows) info(r.map((c, i) => c.padEnd(widths[i])).join("  "));
}

function agentUrl(t) {
	const base = wsBase();
	return t.kind === "http"
		? `${base}/t/${t.room}/__agent`
		: `${base}/p/${t.room}/__agent`;
}

function cmdRoute(argv) {
	// cloudflared parity: `tunnel route dns <NAME> <hostname>` creates a CNAME.
	// We have no DNS step (the Worker URL *is* the route), so `route` prints it.
	const [name] = argv;
	if (!name) fail("usage: tunnel route <name>   (alias: tunnel url <name>)");
	const t = getTunnel(name);
	if (t.kind === "http") {
		info(`${edgeHost()}/t/${t.room}/`);
		info(`agent: EDGE_URL="${wsBase()}/t/${t.room}/__agent" UPSTREAM="${t.upstream}" node agent/agent.js`);
		info(`run it: tunnel run ${name}   (then open the URL above)`);
	} else {
		info(`agent: EDGE_URL="${wsBase()}/p/${t.room}/__agent" SSH_HOST=127.0.0.1 SSH_PORT=22 node agent/tcp-agent.js`);
		info(`laptop: tunnel access ssh ${name}   (alias: tunnel ssh ${name})`);
	}
}
const cmdUrl = cmdRoute;

function cmdInfo(argv) {
	// cloudflared parity: `tunnel info <NAME>` — details + live agent probe.
	const [name] = argv;
	if (!name) fail("usage: tunnel info <name>");
	const t = getTunnel(name);
	const created = t.createdAt ?? "(unknown)";
	info(`name: ${name}`);
	info(`kind: ${t.kind}   room: ${t.room}   created: ${created}`);
	info(`target: ${t.kind === "http" ? t.upstream : t.to}`);
	if (t.kind === "http") {
		const url = `${edgeHost()}/t/${t.room}/`;
		info(`route: ${url}`);
		if (haveBin("curl")) {
			const code = spawnSync("curl", ["-s", "-o", "/dev/null", "-w", "%{http_code}", "--max-time", "10", url], { encoding: "utf8" }).stdout.trim();
			if (code === "502") info("agent: offline (no connector — run: tunnel run " + name + ")");
			else if (code === "404") info("agent: unknown (404 = bad room ID shape — re-check saved value)");
			else if (code) info(`agent: responding (HTTP ${code} — connector live)`);
			else info("agent: unknown (no response)");
		} else {
			info("agent: unknown (curl missing; run: tunnel run " + name + ")");
		}
	} else {
		info(`route: (tcp pipe — no browser URL; use: tunnel access ssh ${name})`);
		info("agent: unknown over plain HTTP (pipes are WS-only; try: tunnel access ssh " + name + ")");
	}
}

function cmdCleanup(argv) {
	// cloudflared parity: `tunnel cleanup <NAME>` drops stale connections.
	// Our rooms are ephemeral server-side (no replica set to prune), so this
	// is a liveness report + local no-op, kept so muscle memory works.
	const [name] = argv;
	if (!name) fail("usage: tunnel cleanup <name>");
	getTunnel(name); // validates name
	info("rooms are ephemeral: nothing stale to delete server-side.");
	info("if an agent looks stuck, restart it (Ctrl-C + tunnel run) — a fresh");
	info("connect supersedes the old one. To forget the name: tunnel delete " + name);
}

function cmdRun(argv) {
	const [name] = argv;
	if (!name) fail("usage: tunnel run <name>");
	const t = getTunnel(name);
	const script = AGENTS[t.kind];
	if (!fs.existsSync(script)) fail(`agent script missing: ${script}`);
	const env = { ...process.env };
	if (t.kind === "http") {
		env.EDGE_URL = `${wsBase()}/t/${t.room}/__agent`;
		env.UPSTREAM = t.upstream;
	} else {
		env.EDGE_URL = `${wsBase()}/p/${t.room}/__agent`;
		const [h, p] = t.to.split(":");
		env.SSH_HOST = h;
		env.SSH_PORT = p || "22";
	}
	info(`running ${t.kind} agent for ${JSON.stringify(name)} (room ${JSON.stringify(t.room)}) — Ctrl-C to stop`);
	const child = spawn("node", [script], { env, stdio: "inherit" });
	child.on("exit", (code) => process.exit(code ?? 1));
}

function sshProxyCmd(t) {
	return `node ${JSON.stringify(path.join(HERE, "ws-ssh-proxy.js"))} ${wsBase()}/p/${t.room}`;
}

function cmdSsh(argv) {
	const [name, ...rest] = argv;
	if (!name) fail("usage: tunnel ssh <name> [--print] [ssh-args...]");
	if (!haveBin("ssh")) fail("ssh binary not found on PATH");
	const t = getTunnel(name);
	if (t.kind !== "tcp") fail(`${JSON.stringify(name)} is an http tunnel — ssh needs a --tcp one`);
	const proxy = sshProxyCmd(t);
	if (rest.includes("--print")) {
		return info(`ssh -o ${JSON.stringify(`ProxyCommand ${proxy}`)} -o ServerAliveInterval=25 -o ServerAliveCountMax=3 ${name}`);
	}
	const args = [
		"-o",
		`ProxyCommand ${proxy}`,
		"-o",
		"ServerAliveInterval=25",
		"-o",
		"ServerAliveCountMax=3",
		name,
		...rest,
	];
	const child = spawn("ssh", args, { stdio: "inherit" });
	child.on("exit", (code) => process.exit(code ?? 1));
}

function cmdAccess(argv) {
	// cloudflared parity: `cloudflared access ssh --hostname ...`.
	// Ours: `tunnel access ssh <name>` (+ ssh-config). Bare `tunnel ssh`
	// stays as an alias.
	const [sub, ...rest] = argv;
	if (sub === "ssh") return cmdSsh(rest);
	if (sub === "ssh-config") return cmdSshConfig(rest);
	if (!sub || sub === "--help" || sub === "-h") {
		cmdHelp("access");
		process.exit(0);
	}
	fail(`unknown access subcommand ${JSON.stringify(sub)} — see: tunnel access ssh --help`);
}

function cmdQuickTunnel(argv) {
	// cloudflared parity: `cloudflared tunnel --url http://localhost:8080`
	// (trycloudflare quick tunnel). Ephemeral: random long room ID, prints
	// public URL, runs the http agent in the foreground.
	// `--name X` persists it as named.
	checkNode();
	const get = (f) => {
		const i = argv.indexOf(f);
		return i >= 0 && argv[i + 1] ? argv[i + 1] : null;
	};
	const upstream = get("--url");
	if (!upstream) fail("usage: tunnel --url http://127.0.0.1:8080 [--name tmp] [--output json]");
	const jsonOut = get("--output") === "json";
	const savedName = get("--name");
	const room = newRoomId();
	const url = `${edgeHost()}/t/${room}/`;
	if (savedName) {
		const state = loadState();
		state.tunnels[savedName] = { kind: "http", room, upstream, createdAt: new Date().toISOString() };
		saveState(state);
	}
	if (jsonOut) {
		console.log(JSON.stringify({ url, room, upstream, ...(savedName ? { name: savedName } : {}) }));
	} else {
		info(`tunnel ready: ${url}`);
		info(`room: ${room}   upstream: ${upstream}${savedName ? `   (saved as ${JSON.stringify(savedName)})` : "   (ephemeral — stops with this process)"}`);
	}
	const env = { ...process.env, EDGE_URL: `${wsBase()}/t/${room}/__agent`, UPSTREAM: upstream };
	const script = AGENTS.http;
	if (!fs.existsSync(script)) fail(`agent script missing: ${script}`);
	const child = spawn("node", [script], { env, stdio: "inherit" });
	child.on("exit", (code) => process.exit(code ?? 1));
}

function cmdSshConfig(argv) {
	const [name, ...rest] = argv;
	if (!name) fail("usage: tunnel ssh-config <name> [--install]");
	const t = getTunnel(name);
	if (t.kind !== "tcp") fail(`${JSON.stringify(name)} is an http tunnel`);
	const block = `Host ${name}
  HostName ${name}
  ProxyCommand ${sshProxyCmd(t)}
  ServerAliveInterval 25
  ServerAliveCountMax 3`;
	if (!rest.includes("--install")) return info(block + "\n");
	const sshConfig = path.join(os.homedir(), ".ssh", "config");
	const begin = `# >>> treaulab tunnel ${name} >>>`;
	const end = `# <<< treaulab tunnel ${name} <<<`;
	const entry = `${begin}\n${block}\n${end}\n`;
	fs.mkdirSync(path.dirname(sshConfig), { recursive: true });
	const cur = fs.existsSync(sshConfig) ? fs.readFileSync(sshConfig, "utf8") : "";
	if (cur.includes(begin)) return info(`already installed in ${sshConfig}`);
	fs.appendFileSync(sshConfig, (cur.endsWith("\n") || !cur ? "" : "\n") + entry);
	try {
		fs.chmodSync(sshConfig, 0o600);
	} catch {}
	info(`appended to ${sshConfig} — now plain \`ssh ${name}\` works`);
}

function cmdLogs() {
	const child = spawn("npx", ["wrangler", "tail"], { cwd: EDGE_DIR, stdio: "inherit" });
	child.on("exit", (code) => process.exit(code ?? 1));
}

function cmdDelete(argv) {
	const [name] = argv;
	if (!name) fail("usage: tunnel delete <name> [-f]");
	const state = loadState();
	if (!state.tunnels[name]) fail(`unknown tunnel ${JSON.stringify(name)}`);
	delete state.tunnels[name];
	saveState(state);
	info(`forgot ${JSON.stringify(name)} (rooms vanish when unused; to revoke access, delete + create a fresh long ID)`);
}

function cmdConfig(argv) {
	const [sub, k, v] = argv;
	const cfg = loadConfig();
	if (!sub || sub === "get") {
		if (k) return info(`${k}=${cfg[k] ?? "(unset)"}`);
		return info(`host=${cfg.host ?? "(unset)"}`);
	}
	if (sub === "set" && k && v !== undefined) {
		if (k !== "host") fail(`unknown key ${JSON.stringify(k)} (only: host)`);
		saveConfig({ ...cfg, host: v.replace(/\/$/, "") });
		return info(`host=${v}`);
	}
	fail("usage: tunnel config [get [host] | set host <URL>]");
}

async function cmdDoctor() {
	checkNode();
	let ok = true;
	const check = (label, pass, hint = "") => {
		info(`${pass ? "PASS" : "FAIL"}  ${label}${pass || !hint ? "" : ` — ${hint}`}`);
		if (!pass) ok = false;
	};
	check(`node >= 22 (have ${process.versions.node})`, Number(process.versions.node.split(".")[0]) >= 22);
	check("ssh on PATH", haveBin("ssh"), "install openssh-client");
	const cfg = loadConfig();
	const host = process.env.TUNNEL_HOST || cfg.host || DEFAULT_HOST;
	check("edge host configured", !!host, "tunnel config set host https://...");
	info(`edge host: ${host} (default ${DEFAULT_HOST}; override with TUNNEL_HOST or tunnel config set host)`);
	if (host) {
		const curl = (p) =>
			spawnSync("curl", ["-s", "-o", "/dev/null", "-w", "%{http_code}", "--max-time", "10", host + p], {
				encoding: "utf8",
			}).stdout.trim();
		const health = haveBin("curl") ? curl("/health") : null;
		if (health === null) {
			info("SKIP  edge reachability (curl missing)");
		} else {
			check("edge reachable (/health → 200)", health === "200", `got ${health || "no response"}`);
			// Long-URL shape check: short IDs must 404; well-formed unused ID must 502/426.
			const short = curl("/t/short/");
			check("short IDs rejected (→ 404)", short === "404", `got ${short || "no response"}`);
			const fresh = newRoomId();
			const good = curl(`/t/${fresh}/`);
			check(
				"long-URL gate answers (unused ID → 502)",
				good === "502",
				`got ${good || "no response"}`,
			);
		}
	}
	const state = loadState();
	info(`remembered tunnels: ${Object.keys(state.tunnels).length} (tunnel list)`);
	process.exit(ok ? 0 : 1);
}

async function cmdQuickstart(argv) {
	checkNode();
	info("1/3 node OK");
	const host = (() => {
		const i = argv.indexOf("--host");
		return ((i >= 0 && argv[i + 1]) || process.env.TUNNEL_HOST || loadConfig().host || DEFAULT_HOST).replace(/\/$/, "");
	})();
	saveConfig({ ...loadConfig(), host });
	info(`2/3 host: ${host} (default; override with --host)`);
	info("3/3 next (mirrors cloudflared):");
	info("  tunnel --url http://127.0.0.1:8080        # instant share, no save (trycloudflare-style)");
	info("  tunnel create site1 --http --upstream http://127.0.0.1:8080");
	info("  tunnel route site1                        # public URL (like: route dns)");
	info("  tunnel run site1                          # on the origin box (like: tunnel run)");
	info("  tunnel access ssh lockedvps               # from the laptop (like: access ssh)");
	info("  tunnel doctor                             # self-check anytime");
}

// ---- main ---------------------------------------------------------------

let raw = process.argv.slice(2);
// Top-level quick tunnel, like `cloudflared tunnel --url ...` (any position).
if (raw.includes("--url")) {
	await cmdQuickTunnel(raw);
	process.exit(0);
}
let [cmd, ...argv] = raw;
// cloudflared muscle memory: `tunnel tunnel <sub>` == `tunnel <sub>`.
if (cmd === "tunnel") {
	[cmd, ...argv] = argv.length ? argv : [undefined];
}
const cmds = {
	help: cmdHelp,
	login: cmdLogin,
	create: cmdCreate,
	list: cmdList,
	info: cmdInfo,
	route: cmdRoute,
	url: cmdUrl,
	run: cmdRun,
	delete: cmdDelete,
	cleanup: cmdCleanup,
	access: cmdAccess,
	ssh: cmdSsh,
	"ssh-config": cmdSshConfig,
	logs: cmdLogs,
	config: cmdConfig,
	doctor: cmdDoctor,
	status: cmdDoctor,
	quickstart: cmdQuickstart,
};
if (!cmd || cmd === "--help" || cmd === "-h") {
	cmdHelp();
	process.exit(0);
}
if (cmd === "help") {
	cmdHelp(argv[0]);
	process.exit(0);
}
// Per-command help, like cloudflared: `tunnel run --help`.
if (argv.includes("--help") || argv.includes("-h")) {
	if (cmds[cmd]) {
		cmdHelp(cmd);
		process.exit(0);
	}
}
if (!cmds[cmd]) {
	cmdHelp();
	fail(`unknown command ${JSON.stringify(cmd)}`);
}
await cmds[cmd](argv);
