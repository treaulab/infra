# cp .dev.vars.example .dev.vars (gitignored) — local `wrangler dev` only.
# Login-only: `npx wrangler login` (spare-account profile). No CLOUDFLARE_API_TOKEN here.
# Spare account only. Never commit real tokens.
RELAY_TOKEN = "dev-only-token-change-me"
# ENABLE_LOG = "0"
# ADMIN_PATH = "admin"
# ALLOWED_HOSTS = ""
# BLOCKED_HOSTS = ""
# RELAY_MAX_BODY = "1048576"
# RELAY_TIMEOUT_MS = "10000"
# UPSTREAM_FORWARDER_URL = ""
# UPSTREAM_AUTH_KEY = ""
# UPSTREAM_FAIL_MODE = "closed"
# VLESS_UUID = "11111111-1111-4111-8111-111111111111"  # dev only; prod via `wrangler secret put VLESS_UUID`
# VLESS_PATH = ""
# VLESS_DOH = "https://1.1.1.1/dns-query"
# VLESS_CONNECT_TIMEOUT_MS = "5000"
# VLESS_DIAL_CONCURRENCY = "2"
