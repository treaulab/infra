# Caller (SPOKE side, SINGLE public repo, e.g. andrewwang2161/dotfiles):
# one repo fans out N tenants by matrix — no fleet of accounts.
# Paste as `.github/workflows/tailnet-runner.yml`, then:
#   1. Replace <PINNED_SHA> with the reviewed treaulab/infra commit SHA
#      (gh api repos/treaulab/infra/commits/main --jq .sha).
#   2. Per tenant: create a GitHub Environment named tailnet-<tenant>
#      holding that tenant's TS_AUTHKEY_EPHEMERAL secret (repo → Settings →
#      Environments). Same secret NAME per environment, distinct VALUES —
#      the matrix leg picks up its own key with zero dynamic secret refs.
#      Optional: required reviewers per environment to gate dispatches.
#   3. Extend the matrix `include` below (one entry per tenant).
#
# Hard rules (do not "simplify"):
#   - Triggers are schedule + workflow_dispatch ONLY. Never add
#     pull_request/push — fork code must never execute in this repo.
#   - Fork-PR workflows: require approval (repo Settings → Actions).
#   - Pin the hub by SHA, never @main. Never `secrets: inherit`.
#   - quiet: "true" always (public logs are world-readable).
#   - Offsets stagger legs so N nodes don't join at the same second.
#
# Dispatch: Run workflow → tenant=all (hourly shape) or one tenant (debug).

name: tailnet-runner

on:
  workflow_dispatch:
    inputs:
      tenant:
        description: "'all' (hourly shape) or one tenant (debug hold)"
        required: false
        default: "all"
  schedule:
    - cron: "7 * * * *"

permissions:
  contents: read

concurrency:
  group: tailnet-runner-${{ matrix.tenant }}
  cancel-in-progress: false

jobs:
  shell:
    strategy:
      fail-fast: false
      matrix:
        include:
          - tenant: t1
            offset: "0"
          - tenant: t2
            offset: "180"
    # Schedule runs every leg; dispatch filters to one (or all).
    if: github.event_name == 'schedule' || inputs.tenant == 'all' || inputs.tenant == matrix.tenant
    environment: tailnet-${{ matrix.tenant }}
    uses: treaulab/infra/.github/workflows/tailnet-runner.yml@<PINNED_SHA>
    with:
      mode: ${{ github.event_name == 'schedule' && 'hourly' || 'debug' }}
      hostname-prefix: gh-${{ matrix.tenant }}
      box-name: box
      edge-url: https://box.treau.me/
      quiet: "true"
      startup-delay-seconds: ${{ matrix.offset }}
    secrets:
      TS_AUTHKEY_EPHEMERAL: ${{ secrets.TS_AUTHKEY_EPHEMERAL }}
