# Caller (SPOKE side, SINGLE public repo, e.g. andrewwang2161/dotfiles):
# one repo fans out N tenants — one calling job per tenant. No fleet of
# accounts.
# Paste as `.github/workflows/tailnet-runner.yml`, then:
#   1. Replace <PINNED_SHA> with the reviewed treaulab/infra commit SHA
#      (gh api repos/treaulab/infra/commits/main --jq .sha).
#   2. Per tenant: ensure a repo-level secret named TS_AUTHKEY_<TENANT>
#      exists (pilot t1/t2 share TS_AUTHKEY_EPHEMERAL until the tenant trio
#      in tofu/tailnet/tenants.tf.example mints distinct keys). Delivered by
#      the tofu ceremony — never pasted, never committed.
#   3. Copy a job block below per tenant (name, secret name, prefix, offset).
#
# Hard rules (do not "simplify"):
#   - Triggers are schedule + workflow_dispatch ONLY. Never add
#     pull_request/push — fork code must never execute in this repo.
#   - Fork-PR workflows: require approval (repo Settings → Actions).
#   - Pin the hub by SHA, never @main. Never `secrets: inherit`.
#   - quiet: "true" always (public logs are world-readable).
#   - Offsets stagger jobs so N nodes don't join at the same second.
#   - Reusable-call jobs accept ONLY name/uses/with/secrets/needs/if/
#     permissions — never add strategy/matrix, environment, or runs-on to a
#     `uses` job. Per-tenant keys are distinct repo secret NAMES, not
#     Environments (unreachable from `uses` jobs).
#
# Dispatch: Run workflow → tenant=all (hourly shape) or one tenant (debug).

name: tailnet-runner

on:
  workflow_dispatch:
    inputs:
      tenant:
        description: "'all' (hourly shape) or one tenant (debug hold)"
        required: false
        default: "all"
  schedule:
    - cron: "7 * * * *"

permissions:
  contents: read

jobs:
  t1:
    if: github.event_name == 'schedule' || inputs.tenant == 'all' || inputs.tenant == 't1'
    concurrency:
      group: tailnet-runner-t1
      cancel-in-progress: false
    uses: treaulab/infra/.github/workflows/tailnet-runner.yml@<PINNED_SHA>
    with:
      mode: ${{ github.event_name == 'schedule' && 'hourly' || 'debug' }}
      hostname-prefix: gh-t1
      box-name: box
      edge-url: https://box.treau.me/
      quiet: "true"
      startup-delay-seconds: "0"
    secrets:
      TS_AUTHKEY_EPHEMERAL: ${{ secrets.TS_AUTHKEY_EPHEMERAL }}

  t2:
    if: github.event_name == 'schedule' || inputs.tenant == 'all' || inputs.tenant == 't2'
    concurrency:
      group: tailnet-runner-t2
      cancel-in-progress: false
    uses: treaulab/infra/.github/workflows/tailnet-runner.yml@<PINNED_SHA>
    with:
      mode: ${{ github.event_name == 'schedule' && 'hourly' || 'debug' }}
      hostname-prefix: gh-t2
      box-name: box
      edge-url: https://box.treau.me/
      quiet: "true"
      startup-delay-seconds: "180"
    secrets:
      TS_AUTHKEY_EPHEMERAL: ${{ secrets.TS_AUTHKEY_EPHEMERAL }}
