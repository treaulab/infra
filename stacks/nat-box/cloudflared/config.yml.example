# cloudflared stable tunnel — NAT box (treau.me)
# Copy to /etc/cloudflared/config.yml and fill tunnel + credentials-file.
# One tunnel serves BOTH HTTP and SSH via ingress hostnames.
# VPS untouched: this file lives only on the NAT box.

tunnel: <YOUR-TUNNEL-UUID>
credentials-file: /root/.cloudflared/<YOUR-TUNNEL-UUID>.json

ingress:
  # HTTP: visitors browse https://box.treau.me/ (edge TLS → plain localhost:8080)
  - hostname: box.treau.me
    service: http://localhost:8080

  # SSH: laptops use `cloudflared access ssh --hostname ssh-box.treau.me`
  # (ssh:// scheme required — not http://, not bare tcp without need)
  - hostname: ssh-box.treau.me
    service: ssh://localhost:22

  # catch-all required — cloudflared refuses to run without it
  - service: http_status:404
