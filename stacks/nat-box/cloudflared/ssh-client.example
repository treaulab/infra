# Laptop ~/.ssh/config snippet for ssh-box.treau.me via cloudflared.
# Requires `cloudflared` on the LAPTOP (client side only, any OS).
# Append to ~/.ssh/config or drop into ~/.ssh/config.d/box (with `Include config.d/*`).
#
# Usage: ssh box / scp f box:/tmp/ / sftp box
# Verify the server fingerprint out-of-band on first connect, as always.

Host box
  HostName ssh-box.treau.me
  User user
  ProxyCommand cloudflared access ssh --hostname %h
  ServerAliveInterval 25
  ServerAliveCountMax 3

# Direct-hostname form (no nickname, same wire):
# Host ssh-box.treau.me
#   ProxyCommand cloudflared access ssh --hostname %h
#   ServerAliveInterval 25
#   ServerAliveCountMax 3
