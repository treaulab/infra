# repomix (packed outputs + cache — never commit packs, they may embed secrets)
repomix-output*
repomix-output/
.repomix/

# tofu / terraform
.tofu/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.example
crash.log
crash*.log
override.tf
override.tf.json
*_override.tf
*.plan
tfplan*
terraform.rc

# ansible / fleet
fleet/inventory/prod.yml
fleet/inventory/*.yml
!fleet/inventory/*.example
fleet/*.retry
fleet/vault.yml
fleet/vault.*.yml
*.vault.pass
fleet/collections/

# kubernetes / k3s local configs
.kube/
*.kubeconfig
k3s-*.yaml

# runtime / secrets — never commit live secrets or DBs.
# Plaintext .env files are a deliberate temporary tradeoff: keep them local
# (or on the host, mode 0600) and commit only .env.example.
.env
*.env
!*.example
!.env.example
*.key
*.pem
*.p12
*.pfx
*.kdbx
secrets/

# azure / gh cli
.azure/
*.publishsettings

# caddy data (if ever bind-mounted instead of named volumes)
stacks/public/caddy/data/
stacks/public/caddy/config/

# docker compose local overrides
compose.override.yml
compose.override.yaml
docker-compose.override.yml
docker-compose.override.yaml

# runners
_runner_work/
_actions_work/
_runner/
_work/

# local cache
.cache/

# python
__pycache__/
*.py[cod]
.venv/
venv/
.venv*/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.uv/

# node (tunnel worker + tooling; the static site has no build step)
node_modules/
.next/
.nuxt/
dist/
build/
out/
.turbo/
.parcel-cache/
*.tsbuildinfo

# cloudflare worker (tunnel only — no generated site assets)
edge/tunnel-worker/.dev.vars
edge/tunnel-worker/.wrangler/

# backups / archives
backups/
*.tar.gz
*.tgz
*.zip
*.bak
*.orig
*.rej

# logs / tmp
*.log
tmp/
temp/

# nix / direnv
result
result-*
.direnv/
.envrc
.envrc.local

# OS/editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.orig
