# Managed by Ansible (roles/dpi_gateway). Do not edit manually.
User tinyproxy
Group tinyproxy
Port {{ gateway_tinyproxy_port }}
Timeout 15
DefaultErrorFile "/usr/share/tinyproxy/default.html"
StatFile "/usr/share/tinyproxy/stats.html"
LogFile "/var/log/tinyproxy/tinyproxy.log"
LogLevel Warning
MaxClients {{ gateway_tinyproxy_max_clients }}
MinSpareServers 10
MaxSpareServers 30
StartServers 10
MaxRequestsPerChild 0
{% for allowed in gateway_tinyproxy_allowed %}
Allow {{ allowed }}
{% endfor %}
ViaProxyName "tinyproxy"
ConnectPort 443
ConnectPort 563
