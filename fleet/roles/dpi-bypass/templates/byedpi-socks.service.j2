[Unit]
Description=byedpi SOCKS5 proxy (DPI bypass)
Documentation=https://github.com/hufrea/byedpi
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ dpi_bypass_user }}
Group={{ dpi_bypass_group }}
ExecStart={{ dpi_bypass_bin }} -i 127.0.0.1 -p {{ dpi_bypass_socks_port }} {{ dpi_bypass_desync_opts }} {{ dpi_bypass_socks_extra_opts }}
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
{% if dpi_bypass_service_capabilities | length > 0 %}
AmbientCapabilities={{ dpi_bypass_service_capabilities | join(' ') }}
CapabilityBoundingSet={{ dpi_bypass_service_capabilities | join(' ') }}
{% else %}
CapabilityBoundingSet=
{% endif %}

[Install]
WantedBy=multi-user.target
