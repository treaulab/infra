#!/usr/bin/env bash
# Managed by the dpi-bypass Ansible role. Do not edit.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin

ACTION="${1:-apply}"
NAT_CHAIN="BYEDPI_NAT"
QUIC_CHAIN="BYEDPI_QUIC"
{% if dpi_bypass_block_quic | bool %}
BLOCK_QUIC=1
{% else %}
BLOCK_QUIC=0
{% endif %}

ipt() {
  iptables -w 5 "$@"
}

remove_jump() {
  local table="$1"
  local chain="$2"
  while ipt -t "$table" -C OUTPUT -j "$chain" 2>/dev/null; do
    ipt -t "$table" -D OUTPUT -j "$chain"
  done
}

remove_chain() {
  local table="$1"
  local chain="$2"
  remove_jump "$table" "$chain"
  ipt -t "$table" -F "$chain" 2>/dev/null || true
  ipt -t "$table" -X "$chain" 2>/dev/null || true
}

apply_rules() {
  ipt -t nat -N "$NAT_CHAIN" 2>/dev/null || true
  ipt -t nat -F "$NAT_CHAIN"
{% for cidr in (dpi_bypass_exclude_cidrs + dpi_bypass_extra_exclude_cidrs) | unique %}
  ipt -t nat -A "$NAT_CHAIN" -d "{{ cidr }}" -j RETURN
{% endfor %}
  ipt -t nat -A "$NAT_CHAIN" -m owner --uid-owner "{{ dpi_bypass_user }}" -j RETURN
{% for port in dpi_bypass_redirect_ports %}
  ipt -t nat -A "$NAT_CHAIN" -p tcp --dport "{{ port }}" -j REDIRECT --to-ports "{{ dpi_bypass_transparent_port }}"
{% endfor %}

  remove_jump nat "$NAT_CHAIN"
  ipt -t nat -I OUTPUT 1 -j "$NAT_CHAIN"

  if [[ "$BLOCK_QUIC" -eq 1 ]]; then
    ipt -N "$QUIC_CHAIN" 2>/dev/null || true
    ipt -F "$QUIC_CHAIN"
{% for cidr in (dpi_bypass_exclude_cidrs + dpi_bypass_extra_exclude_cidrs) | unique %}
    ipt -A "$QUIC_CHAIN" -d "{{ cidr }}" -j RETURN
{% endfor %}
    ipt -A "$QUIC_CHAIN" -p udp --dport 443 -j REJECT
    remove_jump filter "$QUIC_CHAIN"
    ipt -I OUTPUT 1 -j "$QUIC_CHAIN"
  else
    remove_chain filter "$QUIC_CHAIN"
  fi
}

remove_rules() {
  remove_chain nat "$NAT_CHAIN"
  remove_chain filter "$QUIC_CHAIN"
}

case "$ACTION" in
  apply)
    apply_rules
    ;;
  remove)
    remove_rules
    ;;
  *)
    echo "usage: $0 [apply|remove]" >&2
    exit 2
    ;;
esac
