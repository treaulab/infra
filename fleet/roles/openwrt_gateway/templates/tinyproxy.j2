# Managed by Ansible (roles/openwrt_gateway). Do not edit manually.

config tinyproxy
	option enabled '1'
	option User 'nobody'
	option Group 'nogroup'
	option Port '{{ openwrt_tinyproxy_port }}'
	option Timeout '15'
	option DefaultErrorFile '/usr/share/tinyproxy/default.html'
	option StatFile '/usr/share/tinyproxy/stats.html'
	option LogFile '/var/log/tinyproxy.log'
	option LogLevel 'Warning'
	option MaxClients '{{ openwrt_tinyproxy_max_clients }}'
	option MinSpareServers '10'
	option MaxSpareServers '30'
	option StartServers '10'
	option MaxRequestsPerChild '0'
{% for allowed in openwrt_tinyproxy_allowed %}
	list Allow '{{ allowed }}'
{% endfor %}
	option ViaProxyName 'tinyproxy'
	list ConnectPort '443'
	list ConnectPort '563'
