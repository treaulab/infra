# Copy to fleet/inventory/prod.yml (gitignored) and fill.
# Hosts are addressed over Tailscale once joined: use the MagicDNS name or the
# stable 100.x address, not the public IP. Keep a public-IP fallback for the
# VPS only until Tailscale access is proven.
all:
  vars:
    domain: example.com
    acme_email: admin@example.com
    caddy_version: "2.11"
    deploy_root: /opt/stacks
    site_ip: 1.2.3.4
    base_ufw_ports: ["22", "80", "443"]
  children:
    edge:
      hosts:
        vps:
          ansible_host: 1.2.3.4 # VPS public IP until Tailscale is up
          ansible_user: azureuser
          ansible_ssh_private_key_file: ~/.ssh/id_ed25519
    internal:
      vars:
        base_ufw_ports: ["22"]
        enable_k3s: true              # Converge K3s on internal cluster nodes
        k3s_server_url: "https://192.168.10.11:6443"
        internal_gateway: "192.168.10.254" # Transparent proxy gateway for homelab
        # k3s_token: "pre-shared-token-here" # Optional static token; auto-generated if omitted
      hosts:
        mercury:
          ansible_host: 192.168.10.11   # Proxmox VM 500 LAN IP
          ansible_user: treau           # Matches admin_username in platform/proxmox
          ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
          k3s_role: server              # K3s Control Plane Server
          k3s_tls_san:                  # Extra SANs for k3s API server certificate
            - "192.168.10.11"
            - "mercury"
            - "100.x.y.z"
            - "mercury-1"
        venus:
          ansible_host: 192.168.10.12   # Proxmox VM 501 LAN IP
          ansible_user: treau           # Matches admin_username in platform/proxmox
          ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
          k3s_role: agent               # K3s Worker Agent (joins mercury)
    untrusted:
      vars:
        base_ufw_ports: ["22"]
      hosts:
        i:
          ansible_host: 100.x.y.z       # Machine i's Tailscale IP
          ansible_user: treau           # User on machine i
          ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
