all:
  children:
    edge:
      hosts:
        vps:
          ansible_host: 203.0.113.10
          ansible_user: azureuser
          ansible_ssh_private_key_file: ~/.ssh/id_ed25519
          compose_stacks:
            - name: caddy
              src: stacks/edge/caddy
              env_content: "{{ caddy_env_content }}"
    hypervisors:
      hosts:
        entia:
          ansible_host: 192.168.10.10   # Proxmox VE hypervisor host
          ansible_user: root
          ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
    cluster:
      hosts:
        mercury:
          ansible_host: 192.168.10.11
          ansible_user: treau
          ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
          k3s_role: server
          k3s_tls_san:
            - "192.168.10.11"
            - "mercury"
        venus:
          ansible_host: 192.168.10.13
          ansible_user: treau
          ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
          k3s_role: agent
        earth:
          ansible_host: 192.168.10.14
          ansible_user: treau
          ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
          k3s_role: agent
        mars:
          ansible_host: 192.168.10.22
          ansible_user: treau
          ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
          k3s_role: agent
        jupiter:
          ansible_host: 192.168.10.23
          ansible_user: treau
          ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
          k3s_role: agent
        saturn:
          ansible_host: 192.168.10.24
          ansible_user: treau
          ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
          k3s_role: agent
        uranus:
          ansible_host: 192.168.10.25
          ansible_user: treau
          ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
          k3s_role: agent
        neptune:
          ansible_host: 192.168.10.26
          ansible_user: treau
          ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
          k3s_role: agent
        pluto:
          ansible_host: 192.168.10.27
          ansible_user: treau
          ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
          k3s_role: agent
    routers:
      hosts:
        i:
          ansible_host: 192.168.10.254
          ansible_user: treau
          ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
        openwrt:
          ansible_host: 192.168.10.2
          ansible_user: root
          ansible_ssh_common_args: "-o StrictHostKeyChecking=accept-new"
    untrusted:
      hosts:
        beefyboi:
          ansible_host: 192.168.10.69
          ansible_user: beefyboi
          compose_stacks:
            - name: jellyfin
              src: stacks/homelab/jellyfin
              env_file: stacks/homelab/jellyfin/.env.example
        scrawnyboi:
          ansible_host: 192.168.10.67
          ansible_user: scrawnyboi
        nucboi:
          ansible_host: 192.168.10.68
          ansible_user: nucboi
        minecraft:
          ansible_host: 192.168.10.76
          ansible_user: admin
          enable_k3s: true
          k3s_role: server
          k3s_tls_san:
            - "192.168.10.76"
            - "minecraft"
            - "100.116.22.71"
